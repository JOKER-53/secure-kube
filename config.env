# SecureKube configuration
# Sourced by the Makefile — edit this instead of hunting through
# Terraform variables and Helm flags scattered across the repo.

# Cluster shape
CLUSTER_NAME=securekube
CONTROL_PLANE_COUNT=1
WORKER_COUNT=2

# Feature toggles
ENABLE_CALICO=true          # required for NetworkPolicy enforcement on kind
ENABLE_FALCO=true
ENABLE_GATEKEEPER_AUDIT=true

# Lightweight mode (for slower machines / CI): 1 worker, Falco disabled
LIGHT_MODE=false
