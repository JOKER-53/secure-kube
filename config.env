# SecureKube configuration
# Sourced by the Makefile via `include config.env` — edit this instead
# of hunting through Terraform variables and Helm flags scattered
# across the repo.
#
# IMPORTANT: keep values on their own line with NO inline comments.
# `make` includes this file directly, and trailing text after a value
# (even after whitespace) gets pulled into the variable — which breaks
# strict-typed consumers like Terraform bool variables.

# Cluster shape
CLUSTER_NAME=securekube
CONTROL_PLANE_COUNT=1
WORKER_COUNT=2

# Feature toggles: true/false only
# ENABLE_CALICO   - required for NetworkPolicy enforcement on kind
# ENABLE_FALCO    - runtime threat detection
ENABLE_CALICO=true
ENABLE_FALCO=true
ENABLE_GATEKEEPER_AUDIT=true

# Lightweight mode (for slower machines / CI): 1 worker, Falco disabled
LIGHT_MODE=false
